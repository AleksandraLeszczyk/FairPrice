# Copy to .env and fill in your keys.
# Keys marked "required" are needed for specific data layers;
# the app runs (with fallbacks) without any of them.

# FRED — macro rates, CPI, GDP, yield curve
# Register: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=...

# Financial Modeling Prep — detailed financials, peer lists, key metrics
# Free tier: 250 requests/day  |  https://financialmodelingprep.com/developer
FMP_API_KEY=...

# Polygon.io — real-time/delayed prices, options flow
# Free tier: 5 req/min, 2-year history  |  https://polygon.io
POLYGON_API_KEY=...

# Alpaca — market data (MarketView) + news sentiment (FairPrice)
# Same key pair used by both projects — https://alpaca.markets
ALPACA_API_KEY=...
ALPACA_SECRET=...

# Cache settings (optional overrides)
# CACHE_DIR=.cache
# CACHE_TTL_PRICES=300
# CACHE_TTL_FINANCIALS=86400
# CACHE_TTL_MACRO=3600
